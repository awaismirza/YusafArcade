# Dependencies (reinstall with npm install)
node_modules/

# Production build (regenerate with npm run build)
dist/
build/

# TypeScript incremental cache
*.tsbuildinfo

# Vite
.vite/

# Local env / secrets (never commit)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Test / coverage output
coverage/
.nyc_output/

# Caches
.cache/
.parcel-cache/
.eslintcache

# OS junk
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor / IDE (machine-specific)
.idea/
*.swp
*.swo
*~
.vscode/

# Optional deploy tool folders (if you add hosting later)
.vercel/
.netlify/

# Accidental archives in the project folder
*.zip
*.tar
*.tar.gz
*.tgz

# Playwright / e2e artifacts (if added later)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Compiled test bundles
dist-test/

# Agent working notes
.superpowers/
